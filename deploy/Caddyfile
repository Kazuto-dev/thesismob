# Caddy gets and renews the HTTPS certificates by itself, from Let's
# Encrypt, once the domains point at this server.

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The API.
{$API_DOMAIN} {
	import security
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy api:8080
}

# The web app, if you serve it from this server too: copy the contents of
# build/web into deploy/site. Leave APP_DOMAIN unset to skip it.
{$APP_DOMAIN} {
	import security
	encode zstd gzip
	root * /srv/app
	# The service worker and the start page must never be cached, so a new
	# release reaches everyone on their next visit.
	@fresh path /sw.js /index.html /flutter_bootstrap.js /
	header @fresh Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
