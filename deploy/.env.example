# Copy to .env and fill in. Keep .env private: it holds passwords.

# --- Domains -----------------------------------------------------------
# Point each domain's DNS "A" record at this server's public IP first.
API_DOMAIN=api.example.com
# Optional: also serve the web app from this server.
APP_DOMAIN=app.example.com

# --- Database ----------------------------------------------------------
# Letters and numbers only. Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Sign-in -----------------------------------------------------------
# The web client ID from Google Cloud Console > APIs & Services >
# Credentials (several may be listed, comma-separated). Sign-in stays off
# until this is set.
GOOGLE_CLIENT_IDS=
# Google accounts that may issue codes and see every account.
ADMIN_EMAILS=you@gmail.com
# Where the app runs, so browsers may call the API from it.
ALLOWED_ORIGINS=https://app.example.com
APP_URL=https://app.example.com

# --- Email (Gmail or Google Workspace) ---------------------------------
# Turn on 2-step verification on the Google account, then create an app
# password at https://myaccount.google.com/apppasswords and paste it here
# (16 letters, no spaces). Without SMTP_HOST, emails are only logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=BuildQuantify <you@gmail.com>
# Where Enterprise inquiries go.
SALES_EMAIL=you@gmail.com

# --- Plans -------------------------------------------------------------
TRIAL_DAYS=14
FREE_PROJECTS=2
GRACE_DAYS=3
CODE_VALID_DAYS=30
PRICE_BUSINESS_USD=20
PRICE_BUSINESS_PHP=1150
