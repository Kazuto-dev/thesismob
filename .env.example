# Copy to .env and fill in. Keep .env private: it holds passwords.

# --- Domain ------------------------------------------------------------
# The address of the app, such as app.example.com, without https://. In
# Cloudflare, its DNS "A" record points at this server's public IP with
# the proxy on (orange cloud), and SSL/TLS is set to Flexible: Cloudflare
# gives visitors HTTPS and reaches this server on port 80. Used for links
# in emails.
DOMAIN=

# --- Database ----------------------------------------------------------
# Letters and numbers only. Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Sign-in -----------------------------------------------------------
# BuildQuantify's web client ID, from Google Cloud Console > Google Auth
# Platform > Clients. It is not a secret. The pipeline builds the value in
# .env.example into the app, and the API accepts sign-ins for the value in
# .env, so keep the two the same. Sign-in works only on the domain over
# HTTPS, once that address is in the client's authorized JavaScript
# origins. Empty turns sign-in off.
GOOGLE_CLIENT_ID=2714335977-cdcrn777dcju4vr2c8llacpoqdr7of43.apps.googleusercontent.com
# Google accounts that may issue codes and see every account.
ADMIN_EMAILS=you@gmail.com

# --- Email (Gmail or Google Workspace) ---------------------------------
# Turn on 2-step verification on the Google account, then create an app
# password at https://myaccount.google.com/apppasswords and paste it here
# (16 letters, no spaces). Without SMTP_HOST, emails are only logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=BuildQuantify <you@gmail.com>
# Where Enterprise inquiries go.
SALES_EMAIL=you@gmail.com

# --- Plans -------------------------------------------------------------
TRIAL_DAYS=14
FREE_PROJECTS=2
GRACE_DAYS=3
CODE_VALID_DAYS=30
PRICE_BUSINESS_USD=20
PRICE_BUSINESS_PHP=1150
